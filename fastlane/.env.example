# Copy to fastlane/.env. These are placeholders, not credentials.
# Paths are relative to the example root; absolute paths also work. Do not use ~.
ACTIVE_ENV=dev

# Apple Developer Team ID, not the App Store Connect numeric team ID.
APPLE_TEAM_ID=ABCDE12345
IOS_API_KEY_ID=REPLACE_ME
IOS_API_KEY_ISSUER_ID=REPLACE_ME
IOS_API_KEY_PATH=credentials/AuthKey_REPLACE_ME.p8

# A separate private repository accessed using your existing Git SSH identity.
MATCH_GIT_URL=git@github.com:YOUR_ORG/ios-signing.git
MATCH_PASSWORD=REPLACE_ME

# Android upload key and Google Play service account (not google-services.json).
ANDROID_KEYSTORE_PATH=credentials/upload.jks
ANDROID_KEYSTORE_PASSWORD=REPLACE_ME
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=REPLACE_ME
PLAY_JSON_KEY_PATH=credentials/play-service-account.json
